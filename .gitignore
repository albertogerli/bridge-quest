# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# Serwist generated service worker
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# Large video files (stored externally, not in git)
public/videos/*.mp4
public/videos/**/*.mp4

# Large PDF course compilations
public/infografiche/*/corso-*.pdf

# Large PNG intermediates (gpt-image-2 raw output + original Gemini backup)
public/infografiche/*/lezione-*-junior-v*.png
public/infografiche/_backup-gemini/
public/infografiche/*/lezione-*-test-pro.png
public/infografiche/_test-gpt-image-2/

# Temp files
*.tmp
.gitignore.tmp

# Word temp files
~$*.docx

# Legal/sensitive documents
Accordo-*.docx
docs/*.docx

# HeyGen generation state
scripts/video-jobs.json

# Feedback files
Feedback/

# Finder duplicate copies (e.g. "sw 2.js")
public/sw [0-9]*.js
public/swe-worker-* [0-9]*.js

# Local test/scratch files
/check-types.ts
/test-schema.ts
/test-infografica.png
/tmp/
/output/
/.next.nosync/
/.playwright-cli/
scripts/__pycache__/
scripts/*.log
scripts/youtube_token.json

# Playwright / E2E
e2e/.test-user.json
test-results/
playwright-report/
_dump-contenuti.json
audit-contenuti.json
validazione-smazzate.json
